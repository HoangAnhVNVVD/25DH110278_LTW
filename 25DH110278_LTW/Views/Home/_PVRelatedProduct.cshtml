@model IEnumerable<_25DH110278_LTW.Models.Product>

<div class="row">
    <div class="col-md-12">
        <h3 class="bg-info" style="padding: 10px; border-radius: 4px;">SẢN PHẨM CÙNG LOẠI</h3>
    </div>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-3 col-sm-6" style="margin-bottom: 20px;">
                <div class="thumbnail" style="height: 330px; text-align: center; border: 1px solid #ddd; padding: 10px; border-radius: 6px;">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.jpg")" alt="@item.ProductName" style="height: 150px; width: 100%; object-fit: contain;" />
                    </a>
                    <div class="caption">
                        <h4 style="height: 35px; overflow: hidden; font-size: 14px;">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">@item.ProductName</a>
                        </h4>
                        <p style="color: #d9534f; font-weight: bold;">
                            @item.ProductPrice.ToString("N0") đ
                        </p>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-default btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    }
</div>