@model _25DH110278_LTW.Models.ViewModel.ProductDetailVM

@{
    ViewBag.Title = Model.ProductDetail.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row" style="margin-top: 25px; margin-bottom: 35px;">
    <div class="col-md-5 text-center">
        <img src="@Url.Content(Model.ProductDetail.ProductImage ?? "~/Content/images/default.jpg")" alt="@Model.ProductDetail.ProductName" class="img-responsive img-thumbnail" style="max-height: 380px; margin: 0 auto;" />
    </div>

    <div class="col-md-7">
        <h2>@Model.ProductDetail.ProductName</h2>
        <p class="text-muted">Danh mục: <strong>@Model.ProductDetail.Category.CategoryName</strong></p>
        <hr />
        <h3 style="color: #d9534f; font-weight: bold; margin-bottom: 20px;">
            @Model.ProductDetail.ProductPrice.ToString("N0") đ
        </h3>

        <div style="margin-bottom: 20px;">
            <h4>Mô tả sản phẩm:</h4>
            <p style="font-size: 15px; line-height: 1.6; color: #555;">@Model.ProductDetail.ProductDecription</p>
        </div>

        @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new { @class = "form-inline" }))
        {
            @Html.Hidden("id", Model.ProductDetail.ProductID)
            <div class="form-group">
                <label for="quantity">Số lượng:</label>
                <input type="number" id="quantity" name="quantity" class="form-control" value="1" min="1" max="99" style="width: 80px; text-align: center; margin-left: 10px; margin-right: 15px;" />
            </div>
            <button type="submit" class="btn btn-danger btn-lg">
                <span class="glyphicon glyphicon-shopping-cart"></span> Thêm vào giỏ hàng
            </button>
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default btn-lg", style = "margin-left: 10px;" })
        }
    </div>
</div>

<hr />

@Html.Partial("_PVRelatedProduct", Model.RelatedProducts)