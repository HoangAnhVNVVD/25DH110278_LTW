@model IEnumerable<_25DH110278_LTW.Models.ViewModel.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="bg-primary text-white" style="padding: 10px; border-radius: 4px;">GIỎ HÀNG CỦA BẠN</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped" style="margin-top: 20px;">
        <thead>
            <tr class="bg-info">
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th style="width: 140px;">Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.jpg")" alt="@item.ProductName" style="max-height: 70px; max-width: 90px; object-fit: contain;" />
                    </td>
                    <td style="font-weight: 500;">@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("N0") đ</td>
                    <td>
                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "form-inline" }))
                        {
                            @Html.Hidden("id", item.ProductID)
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control input-sm" style="width: 65px; text-align: center;" />
                            <button type="submit" class="btn btn-default btn-sm" title="Cập nhật"><span class="glyphicon glyphicon-refresh"></span></button>
                        }
                    </td>
                    <td style="color: #d9534f; font-weight: bold;">@item.TotalPrice.ToString("N0") đ</td>
                    <td>
                        @Html.ActionLink("Xóa", "RemoveFromCart", "Cart", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="font-size: 16px;">
                <td colspan="4" class="text-right" style="font-weight: bold;">Tổng cộng:</td>
                <td colspan="2" style="color: #d9534f; font-weight: bold; font-size: 18px;">
                    @Model.Sum(i => i.TotalPrice).ToString("N0") đ
                </td>
            </tr>
        </tfoot>
    </table>

    <div class="row" style="margin-top: 20px; margin-bottom: 30px;">
        <div class="col-md-6">
            @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-default btn-lg" })
            @Html.ActionLink("Xóa toàn bộ giỏ", "ClearCart", "Cart", null, new { @class = "btn btn-warning btn-lg", style = "margin-left: 10px;" })
        </div>
        <div class="col-md-6 text-right">
            <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg">
                <span class="glyphicon glyphicon-ok"></span> Tiến hành Đặt hàng
            </a>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" style="margin-top: 25px; padding: 20px;">
        <h4>Giỏ hàng của bạn đang trống!</h4>
        <p>Hãy dạo một vòng cửa hàng để chọn cho mình những sản phẩm ưng ý nhất nhé.</p>
        <p style="margin-top: 15px;">
            @Html.ActionLink("Quay về Trang chủ mua sắm", "Index", "Home", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}