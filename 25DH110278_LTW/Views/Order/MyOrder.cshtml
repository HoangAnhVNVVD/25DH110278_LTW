@model IEnumerable<_25DH110278_LTW.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="bg-primary text-white" style="padding: 10px; border-radius: 4px;">LỊCH SỬ ĐƠN HÀNG CỦA TÔI</h2>

@if (Model != null && Model.Any())
{
    foreach (var order in Model)
    {
        <div class="panel panel-default" style="margin-top: 20px;">
            <div class="panel-heading" style="background-color: #f5f5f5;">
                <div class="row">
                    <div class="col-md-6">
                        <strong>Mã đơn hàng: #@order.OrderID</strong> | Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy")
                    </div>
                    <div class="col-md-6 text-right">
                        Trạng thái: <span class="label label-success">@order.PaymentStatus</span>
                    </div>
                </div>
            </div>
            <div class="panel-body">
                <p><strong>Giao đến:</strong> @order.AddressDelivery</p>
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in order.OrderDetails)
                        {
                            <tr>
                                <td>@detail.Product.ProductName</td>
                                <td class="text-center">@detail.Quantity</td>
                                <td class="text-right">@detail.UnitPrice.ToString("N0") đ</td>
                                <td class="text-right">@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-right" style="font-weight: bold;">Tổng tiền:</td>
                            <td class="text-right" style="color: #d9534f; font-weight: bold; font-size: 16px;">
                                @order.TotalAmount.ToString("N0") đ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info" style="margin-top: 25px;">
        <p>Bạn chưa có đơn đặt hàng nào trong tài khoản.</p>
        <p style="margin-top: 10px;">
            @Html.ActionLink("Bắt đầu mua sắm ngay", "Index", "Home", null, new { @class = "btn btn-primary" })
        </p>
    </div>
}