@model _25DH110278_LTW.Models.Category

@{
    ViewBag.Title = "Xóa Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-danger text-white" style="padding: 10px; border-radius: 4px;">XÁC NHẬN XÓA DANH MỤC</h2>

<h3>Bạn có chắc chắn muốn xóa danh mục này không?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên danh mục:</dt>
        <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>