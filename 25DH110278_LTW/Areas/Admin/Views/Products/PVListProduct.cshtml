@model _25DH110278_LTW.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

<style>
    img {
        height: 100px;
        max-width: 150px;
        object-fit: cover;
    }

    .pagination-container {
        text-align: center;
    }
</style>

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.Products != null && Model.Products.Any())
{
    <h2 class="bg-success text-white" style="padding: 10px; border-radius: 4px;">DANH SÁCH SẢN PHẨM</h2>

    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr class="bg-success">
                <th class="col-md-2">Hình ảnh</th>
                <th class="col-md-3">Tên sản phẩm</th>
                <th class="col-md-2">Đơn giá</th>
                <th class="col-md-2">Danh mục</th>
                <th class="col-md-3">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ProductImage))
                        {
                            <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" class="img-thumbnail" />
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => product.ProductName)</td>
                    <td>@product.ProductPrice.ToString("N0") đ</td>
                    <td>@Html.DisplayFor(modelItem => product.Category.CategoryName)</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Hiển thị phân trang theo Slide 49 -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = Model.SortOrder
        }))
    </div>
}
else
{
    <p class="alert alert-warning">Không tìm được sản phẩm nào phù hợp.</p>
}

<div class="form-group" style="margin-top: 15px;">
    @Html.ActionLink("Thêm mới sản phẩm", "Create", null, new { @class = "btn btn-primary" })
</div>
